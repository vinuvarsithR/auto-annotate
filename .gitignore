# Secrets - never commit
.env
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Model weights and caches (large, re-downloadable)
models/*
!models/.gitkeep
*.pt
*.pth
*.safetensors
*.onnx
.cache/

# App data (uploads, database, job outputs) - added in later phases
data/
runs/
*.db
*.sqlite3

# Gold-set images are large; keep them out of git by default.
# The labels (annotations.json, classes.yaml) ARE committed.
gold_sets/*/images/*
!gold_sets/*/images/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
