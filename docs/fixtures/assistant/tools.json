{
 "_note": "Claude connector tool list (docs/CONTRACT.md 'Claude connector'). Names, order, descriptions and input_schema are exact: MCP tools/list and the chat's tools come from this. 'kind' and 'risky' are contract metadata, not sent. The chat drops the 'confirm' property from every schema. Example outputs use the api_samples.json data. Exact: ok, error.code, needs_confirmation.details and .arguments, and data keys; error.message and needs_confirmation.effect are examples. A write example with 'user' was made by that user (reviewer 'claude:<user>'). An example with 'state' needs that extra state added to the test DB first; examples without it run on the api_samples.json data (project 1, images 10-12, boxes 101-108, jobs 5-12).",
 "tools": [
  {
   "name": "list_projects",
   "kind": "read",
   "risky": "never",
   "description": "List all projects with box counts by status.",
   "input_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
   }
  },
  {
   "name": "project_summary",
   "kind": "read",
   "risky": "never",
   "description": "One project: image counts by review status, box counts by class and status, the latest job.",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     }
    },
    "required": [
     "project_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "list_images",
   "kind": "read",
   "risky": "never",
   "description": "List a project's images (id order). status = images having at least one box with that status.",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     },
     "status": {
      "type": "string",
      "enum": [
       "auto_accepted",
       "needs_review",
       "accepted",
       "rejected",
       "edited"
      ]
     },
     "review_status": {
      "type": "string",
      "enum": [
       "todo",
       "done",
       "empty"
      ]
     },
     "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 50
     }
    },
    "required": [
     "project_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "get_annotations",
   "kind": "read",
   "risky": "never",
   "description": "The image and its boxes (bbox [x, y, w, h] px, polygon normalized 0..1 or null).",
   "input_schema": {
    "type": "object",
    "properties": {
     "image_id": {
      "type": "integer",
      "minimum": 1
     },
     "status": {
      "type": "string",
      "enum": [
       "auto_accepted",
       "needs_review",
       "accepted",
       "rejected",
       "edited"
      ]
     }
    },
    "required": [
     "image_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "list_classes",
   "kind": "read",
   "risky": "never",
   "description": "The project's classes in project order (the YOLO export order).",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     }
    },
    "required": [
     "project_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "get_job",
   "kind": "read",
   "risky": "never",
   "description": "A job's status, progress and result.",
   "input_schema": {
    "type": "object",
    "properties": {
     "job_id": {
      "type": "integer",
      "minimum": 1
     }
    },
    "required": [
     "job_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "list_models",
   "kind": "read",
   "risky": "never",
   "description": "Detector names and their modes usable for run_detection in this project.",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     }
    },
    "required": [
     "project_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "get_hook",
   "kind": "read",
   "risky": "never",
   "description": "Hook-filter settings and the hook point of each video (sequence) of the project.",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     }
    },
    "required": [
     "project_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "add_class",
   "kind": "write",
   "risky": "never",
   "description": "Add one class at the end of the project's class list.",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     },
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
     },
     "description": {
      "type": "string",
      "maxLength": 500
     },
     "min_score": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0,
      "maximum": 1
     },
     "accept_score": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0,
      "maximum": 1
     }
    },
    "required": [
     "project_id",
     "name"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "run_detection",
   "kind": "write",
   "risky": "more than 50 images",
   "description": "Start a detect job (#9). image_ids omitted = all images of the project. Needs confirm=true when it would run on more than 50 images.",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     },
     "model": {
      "type": "string",
      "minLength": 1
     },
     "mode": {
      "type": [
       "string",
       "null"
      ]
     },
     "image_ids": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 1
      },
      "minItems": 1,
      "maxItems": 10000
     },
     "masks": {
      "type": "string",
      "enum": [
       "sam2",
       "none"
      ]
     },
     "confirm": {
      "type": "boolean",
      "default": false,
      "description": "true only after the human has seen the needs_confirmation result and said yes"
     }
    },
    "required": [
     "project_id",
     "model"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "rerun_examples",
   "kind": "write",
   "risky": "more than 50 images",
   "description": "Re-run the last examples-mode job on every image still in review_status todo (#9 rerun). Needs confirm=true when that is more than 50 images.",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     },
     "confirm": {
      "type": "boolean",
      "default": false,
      "description": "true only after the human has seen the needs_confirmation result and said yes"
     }
    },
    "required": [
     "project_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "set_annotation_status",
   "kind": "write",
   "risky": "more than 10 boxes",
   "description": "Approve (status accepted) or reject (status rejected) boxes. All or nothing. Needs confirm=true for more than 10 boxes.",
   "input_schema": {
    "type": "object",
    "properties": {
     "annotation_ids": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 1
      },
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true
     },
     "action": {
      "type": "string",
      "enum": [
       "approve",
       "reject"
      ]
     },
     "confirm": {
      "type": "boolean",
      "default": false,
      "description": "true only after the human has seen the needs_confirmation result and said yes"
     }
    },
    "required": [
     "annotation_ids",
     "action"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "update_annotation",
   "kind": "write",
   "risky": "never",
   "description": "Change one box (#13 rules): bbox px, polygon (normalized; null removes it), class by name, or status. Send at least one field.",
   "input_schema": {
    "type": "object",
    "properties": {
     "annotation_id": {
      "type": "integer",
      "minimum": 1
     },
     "bbox": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
     },
     "polygon": {
      "type": [
       "array",
       "null"
      ],
      "minItems": 3,
      "items": {
       "type": "array",
       "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "minItems": 2,
       "maxItems": 2
      }
     },
     "class_name": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "type": "string",
      "enum": [
       "auto_accepted",
       "needs_review",
       "accepted",
       "rejected",
       "edited"
      ]
     }
    },
    "required": [
     "annotation_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "delete_annotation",
   "kind": "write",
   "risky": "always",
   "description": "Permanently delete one box (#19). Prefer set_annotation_status reject for model boxes, so they still count for precision. Always needs confirm=true.",
   "input_schema": {
    "type": "object",
    "properties": {
     "annotation_id": {
      "type": "integer",
      "minimum": 1
     },
     "confirm": {
      "type": "boolean",
      "default": false,
      "description": "true only after the human has seen the needs_confirmation result and said yes"
     }
    },
    "required": [
     "annotation_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "set_hook_point",
   "kind": "write",
   "risky": "never",
   "description": "Set the hook point (x, y image pixels) of the video (sequence) that image_id belongs to (#28).",
   "input_schema": {
    "type": "object",
    "properties": {
     "image_id": {
      "type": "integer",
      "minimum": 1
     },
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     }
    },
    "required": [
     "image_id",
     "x",
     "y"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "make_train_package",
   "kind": "write",
   "risky": "never",
   "description": "Build the Colab training package zip (#23) and return a download link for the human.",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     },
     "task": {
      "type": "string",
      "enum": [
       "detect",
       "segment"
      ],
      "default": "detect"
     }
    },
    "required": [
     "project_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "start_training",
   "kind": "write",
   "risky": "target local (reserved)",
   "description": "Start training a model on the project's reviewed images (#37). target 'colab' returns a training package download link and the steps to run it on Google Colab; target 'local' (GPU on the app host) is not available on this host and returns an error that points to colab.",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     },
     "target": {
      "type": "string",
      "enum": [
       "colab",
       "local"
      ]
     },
     "task": {
      "type": "string",
      "enum": [
       "detect",
       "segment"
      ],
      "default": "segment"
     },
     "epochs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 50
     },
     "imgsz": {
      "type": "integer",
      "minimum": 320,
      "maximum": 2048,
      "multipleOf": 32,
      "default": 960
     },
     "base_weights": {
      "type": "string",
      "enum": [
       "yolo11n.pt",
       "yolo11s.pt",
       "yolo11m.pt",
       "yolo11l.pt",
       "yolo11x.pt",
       "yolo11n-seg.pt",
       "yolo11s-seg.pt",
       "yolo11m-seg.pt",
       "yolo11l-seg.pt",
       "yolo11x-seg.pt"
      ]
     },
     "confirm": {
      "type": "boolean",
      "default": false,
      "description": "true only after the human has seen the needs_confirmation result and said yes"
     }
    },
    "required": [
     "project_id",
     "target"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "import_weights",
   "kind": "write",
   "risky": "always",
   "description": "Import trained weights (a best.pt from Colab) that are on the app host's disk, inside an import folder such as the Google Drive folder (#38). Registers them like an upload: listed by list_models and usable by run_detection. Loading a .pt runs code, so always confirm.",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     },
     "path": {
      "type": "string",
      "minLength": 1
     },
     "task": {
      "type": "string",
      "enum": [
       "detect",
       "segment"
      ]
     },
     "metrics_path": {
      "type": [
       "string",
       "null"
      ],
      "default": null
     },
     "confirm": {
      "type": "boolean",
      "default": false,
      "description": "true only after the human has seen the needs_confirmation result and said yes"
     }
    },
    "required": [
     "project_id",
     "path",
     "task"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "push_to_roboflow",
   "kind": "write",
   "risky": "always",
   "description": "Start a Roboflow push job (#21) for done/empty images not pushed yet. Always needs confirm=true.",
   "input_schema": {
    "type": "object",
    "properties": {
     "project_id": {
      "type": "integer",
      "minimum": 1
     },
     "statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "enum": [
        "auto_accepted",
        "needs_review",
        "accepted",
        "edited"
       ]
      }
     },
     "confirm": {
      "type": "boolean",
      "default": false,
      "description": "true only after the human has seen the needs_confirmation result and said yes"
     }
    },
    "required": [
     "project_id"
    ],
    "additionalProperties": false
   }
  }
 ],
