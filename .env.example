# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit it, print it, or paste it into chat.

ROBOFLOW_API_KEY=

# Claude connector (docs/CONTRACT.md "Claude connector").
# Sidebar chat: the server's Anthropic API key. Empty = chat off. Never share it or paste it anywhere.
ANTHROPIC_API_KEY=
# AUTOLABEL_CLAUDE_MODEL=claude-sonnet-5-5
# AUTOLABEL_CLAUDE_EFFORT=low
# AUTOLABEL_CLAUDE_MAX_TOOL_CALLS=10
# AUTOLABEL_CLAUDE_MAX_TOKENS=16000
# MCP for teammates on the LAN: a long random shared token (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))").
# Empty = MCP works only on this machine. Anyone with the token can use every tool; see README.
AUTOLABEL_MCP_TOKEN=

# Teammate tokens (scripts/add_teammate.py): hashes only, default data/mcp_users.json
# AUTOLABEL_MCP_USERS_FILE=
# Folders import_weights / #38 may read .pt files from, separated by ;  (default data/inbox)
# AUTOLABEL_IMPORT_DIRS=D:\autoannotate\inbox;G:\My Drive\autolabel
# Web-app address used in links Claude gives (e.g. http://192.168.1.20:8000); unset = the request's Host
# AUTOLABEL_PUBLIC_URL=
